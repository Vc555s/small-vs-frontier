# Environments and Python caches
.venv/
.venv-light/
venv/
__pycache__/
*.pyc

# Secrets
.env
.env.*

# Model weights and caches
results/adapter_*/
results/stress/adapter_*/
*.safetensors
*.bin
*.pt
hf_cache/
.cache/
results/baselines/emb/

# Raw Claude CLI output (contains session identifiers)
results/claude_code_raw/
results/stress/claude_raw/
results/baselines/claude_raw/

# Pipeline state and logs (each finished stage leaves a marker so a re-run resumes)
results/*log*.txt
results/stress/.*
results/stress/*.partial
results/stress/STATUS.md
results/stress/logs/
results/stress/pipeline.log
results/baselines/.*
results/baselines/*.tmp
results/baselines/STATUS.md
results/baselines/logs/
results/baselines/pipeline.log

# Working folders of the full-training-set runs (adapters, raw outputs, pipeline state);
# their results are copied next to the other result files
results/full_data/
results/baselines/full_data_s*/

# Test runs of the pipelines
results/stress_dryrun/
results/full_data_testrun/
results/baselines_testrun/
